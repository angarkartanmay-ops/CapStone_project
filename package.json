{
  "name": "spillway",
  "version": "1.0.0",
  "description": "Spillway: a real-time multiplayer shedding card game. HTML/CSS/JS frontend, Node.js + Express backend, MongoDB database.",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.27",
    "mongodb-memory-server": "^10.4.3",
    "mongoose": "^8.24.7",
    "socket.io": "^4.8.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
